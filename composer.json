{
    "name": "alacena-utn/alacena",
    "description": "Despensa visual y recomendación de recetas · Proyecto final UTN",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": { "Alacena\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Alacena\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": ["@php scripts/lint-php.php", "phpcs"],
        "format": "phpcbf",
        "servidor": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8080 -t public public/router.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}

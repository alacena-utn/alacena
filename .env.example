# Copiá este archivo como .env y completá los valores.
# El .env NO se sube al repositorio (está en .gitignore).

# Base de datos — estos valores sirven tal cual con Docker (docker-compose.yml)
DB_HOST=db
DB_PORT=3306
DB_NAME=cooki
DB_USER=cooki
DB_PASS=cooki
DB_ROOT_PASS=root

# Con XAMPP / Laragon (sin Docker) normalmente es:
# DB_HOST=127.0.0.1
# DB_USER=root
# DB_PASS=

# Entorno: desarrollo | produccion  (en produccion no se muestran detalles de errores)
APP_ENV=desarrollo
# En el hosting, si tiene certificado (https), poné 1 para que todo vaya por https
FORZAR_HTTPS=0

# Dirección pública del sitio, para los enlaces de los correos (recuperar la contraseña).
# En desarrollo puede quedar vacía; en el hosting conviene ponerla, por ejemplo https://cooki.mi-hosting.com
APP_URL=

# Correo del formulario de contacto (dirección simulada del sitio).
# Con Docker los correos se ven en Mailpit: http://localhost:8025
MAIL_CONTACTO=contacto@cooki.test
MAIL_REMITENTE=no-responder@cooki.test

# Servidor de correo (cliente SMTP propio, src/Smtp.php). Si MAIL_HOST queda vacío se usa mail() de PHP.
# Con Docker: mailpit, puerto 1025, sin seguridad ni usuario (ya está así).
# Con XAMPP sin Mailpit: dejá MAIL_HOST vacío (los correos no salen, pero todo lo demás anda).
# En el hosting: los datos del servidor de correo (por ejemplo, puerto 587 con MAIL_SEGURIDAD=tls).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SEGURIDAD=ninguna
MAIL_USUARIO=
MAIL_CONTRASENA=
